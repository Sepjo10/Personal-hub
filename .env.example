# Copia este archivo como .env.local y rellena los valores reales.
# .env.local NO se sube a GitHub (está en .gitignore).

# Supabase -> Project Settings -> API (o botón "Connect")
# Ambas son públicas: van al navegador y la seguridad la garantiza RLS.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# NUNCA añadas aquí la "secret key" / "service_role" con prefijo NEXT_PUBLIC_.

# Google Calendar (Fase 6) -> Google Cloud Console -> Google Auth Platform -> Clientes
# Son SECRETOS: sin NEXT_PUBLIC_, solo los usa el servidor.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Clave para cifrar el refresh token (32 bytes en base64). Genérala con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_KEY=genera-tu-propia-clave

# Notificaciones push (Fase 7). Genera las claves con: npx.cmd web-push generate-vapid-keys
# La pública va al navegador (NEXT_PUBLIC_); la privada NUNCA.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=clave-publica-vapid
VAPID_PRIVATE_KEY=clave-privada-vapid
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Secreto del cron diario (Vercel lo envía en la cabecera Authorization). Genéralo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=genera-tu-propio-secreto
